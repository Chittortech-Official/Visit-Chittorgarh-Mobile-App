<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardAudioStory"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#24324C"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Thumbnail Image -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgThumb"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent" />

        <!-- Info Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtAudioTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vijay Stambha"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtAudioHindi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="विजय स्तम्भ की गौरव गाथा"
                android:textColor="@color/gold_bright"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtAudioCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tower of Victory • 2 mins narration"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Play / Stop Button -->
        <ImageView
            android:id="@+id/btnPlayStop"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_badge_gold"
            android:padding="10dp"
            android:src="@drawable/ic_play_arrow"
            android:contentDescription="Play Narration"
            app:tint="@color/gold_bright" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

