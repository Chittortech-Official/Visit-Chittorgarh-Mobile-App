<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_background">

    <!-- MAIN APP CONTENT (Vertical Responsive Layout: Top Bar -> Dynamic Content Frame -> Bottom Bar) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/window_background">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_white"
            app:elevation="2dp">

            <!-- World-Class Header Bar with Hamburger Menu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <!-- 🍔 Hamburger Menu Button -->
                <ImageView
                    android:id="@+id/btnHamburger"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_btn_circle_hamburger"
                    android:padding="9dp"
                    android:src="@drawable/ic_menu_hamburger"
                    android:contentDescription="Open Navigation Menu" />

                <!-- Logo & Brand Header -->
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/chittorgarh_tourism_logo"
                    android:contentDescription="Visit Chittorgarh Crest" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Visit Chittorgarh"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Official Tourism &amp; Fort Guide"
                        android:textColor="@color/accent_gold"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <!-- Quick WhatsApp Action -->
                <ImageView
                    android:id="@+id/btnHeaderWhatsApp"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_btn_circle_whatsapp"
                    android:padding="8dp"
                    android:src="@drawable/ic_whatsapp"
                    android:contentDescription="WhatsApp Support" />

                <!-- Quick Call Helpline -->
                <ImageView
                    android:id="@+id/btnHeaderCall"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_btn_circle_call"
                    android:padding="9dp"
                    android:src="@drawable/ic_phone"
                    app:tint="@color/accent_gold"
                    android:contentDescription="Call Helpline" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_subtle" />
        </com.google.android.material.appbar.AppBarLayout>

        <!-- Main Content Frame (Switching between tabs - dynamically fills space) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- TAB 1: EXPLORE -->
            <LinearLayout
                android:id="@+id/layoutTabExplore"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Search Box Pill -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_search_box"
                        android:elevation="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_search"
                            app:tint="@color/accent_gold" />

                        <EditText
                            android:id="@+id/editSearch"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/search_hint"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_light"
                            android:textSize="13.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 👑 VIP & Foreign Guest Tour Promotion Banner -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardExploreVipBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/surface_white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/border_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="10dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_btn_circle_call"
                            android:padding="6dp"
                            android:src="@drawable/ic_nav_explore"
                            app:tint="@color/accent_gold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Foreign Guest &amp; VIP Tour Pass"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Approved Multilingual Guides • Private Cabs"
                                android:textColor="@color/accent_gold"
                                android:textSize="10.5sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_gold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="Book ↗"
                            android:textColor="@color/gold_badge_text"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Horizontal Category Filter Pills -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:paddingHorizontal="16dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layoutCategoryChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">

                        <TextView
                            android:id="@+id/chipAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_selected"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:text="🏰 All Sites"
                            android:textColor="@color/surface_white"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipFavorites"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_chip_unselected"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:text="❤️ Saved"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/chipTowers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_chip_unselected"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:text="🏆 Victory Towers"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/chipPalaces"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_chip_unselected"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:text="👑 Royal Palaces"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/chipTemples"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_chip_unselected"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:text="🛕 Sacred Temples"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/chipReservoirs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_chip_unselected"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:text="💧 Water Reservoirs"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/chipGates"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_chip_unselected"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:text="🚪 Fort Gates (Pol)"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Monuments List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerMonuments"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="4dp"
                    android:clipToPadding="false"
                    android:paddingBottom="16dp" />
            </LinearLayout>

            <!-- TAB 2: AUDIO GUIDE -->
            <LinearLayout
                android:id="@+id/layoutTabAudio"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Now Playing Banner Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    app:cardBackgroundColor="@color/surface_white"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/border_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:src="@drawable/ic_nav_audio"
                                app:tint="@color/accent_gold" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/txtAudioNowPlayingTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Select a story to play"
                                    android:textColor="@color/text_primary"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/txtAudioNowPlayingStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Official Mewari Heritage Narration"
                                    android:textColor="@color/accent_gold"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <com.google.android.material.floatingactionbutton.FloatingActionButton
                                android:id="@+id/fabTabPlayAudio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:backgroundTint="@color/accent_gold"
                                app:fabCustomSize="48dp"
                                app:srcCompat="@drawable/ic_play_arrow"
                                app:tint="@color/surface_white" />
                        </LinearLayout>

                        <!-- Narration Transcript Preview -->
                        <TextView
                            android:id="@+id/txtNarrationPreview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:ellipsize="end"
                            android:lineSpacingExtra="3dp"
                            android:maxLines="3"
                            android:text="Choose any landmark below to begin listening to audio guide stories recorded from the annals of Chittorgarh history."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginBottom="6dp"
                    android:text="All Audio Stories (10 Landmarks)"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Stories List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerAudioStories"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="16dp" />
            </LinearLayout>

            <!-- TAB 3: TOURS & ITINERARIES -->
            <LinearLayout
                android:id="@+id/layoutTabItineraries"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Curated Fort Circuits"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Optimized walking &amp; driving routes designed by local historians"
                        android:textColor="@color/accent_gold"
                        android:textSize="12sp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerItineraries"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="16dp" />
            </LinearLayout>

            <!-- TAB 4: SERVICES & ESSENTIALS -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/layoutTabServices"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="24dp">

                    <!-- Emergency Helplines Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="16dp"
                        app:cardBackgroundColor="@color/surface_white"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="3dp"
                        app:strokeColor="@color/border_subtle"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🚨 24/7 Fort &amp; Tourist Helplines"
                                android:textColor="@color/ruby_crimson"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Instant dial assistance for tourists atop the 700-acre fort"
                                android:textColor="@color/text_muted"
                                android:textSize="11.5sp" />

                            <!-- Buttons Row 1: Helpline & WhatsApp -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnCallTouristHelpline"
                                    android:layout_width="0dp"
                                    android:layout_height="46dp"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="6dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:backgroundTint="@color/surface_secondary"
                                    android:text="Helpline"
                                    android:textAllCaps="false"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12.5sp"
                                    android:textStyle="bold"
                                    app:cornerRadius="10dp"
                                    app:icon="@drawable/ic_phone"
                                    app:iconSize="16dp"
                                    app:iconTint="@color/accent_gold" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnServiceWhatsApp"
                                    android:layout_width="0dp"
                                    android:layout_height="46dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="6dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:backgroundTint="@color/whatsapp_green"
                                    android:text="WhatsApp"
                                    android:textAllCaps="false"
                                    android:textColor="@color/surface_white"
                                    android:textSize="12.5sp"
                                    android:textStyle="bold"
                                    app:cornerRadius="10dp"
                                    app:icon="@drawable/ic_whatsapp"
                                    app:iconSize="16dp"
                                    app:iconTint="@color/surface_white" />
                            </LinearLayout>

                            <!-- Buttons Row 2: Control Room & Police -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnCallFortControl"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="46dp"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="6dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:text="Control Room"
                                    android:textAllCaps="false"
                                    android:textColor="@color/accent_gold"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    app:cornerRadius="10dp"
                                    app:strokeColor="@color/accent_gold" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnCallPolice"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="46dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="6dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:text="Police (112)"
                                    android:textAllCaps="false"
                                    android:textColor="@color/ruby_crimson"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    app:cornerRadius="10dp"
                                    app:strokeColor="@color/ruby_crimson" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Timings & Tickets Guide Card (Clean White) -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginBottom="12dp"
                        app:cardBackgroundColor="@color/surface_white"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="3dp"
                        app:strokeColor="@color/border_subtle"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🎟️ Timings, Tickets &amp; Sound Show"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <!-- Timings -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="Fort &amp; Monument Timings"
                                android:textColor="@color/accent_gold"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:lineSpacingExtra="3dp"
                                android:text="@string/timings_info"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <!-- Tickets -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="ASI Entry Ticket Charges"
                                android:textColor="@color/accent_gold"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:lineSpacingExtra="3dp"
                                android:text="@string/tickets_info"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <!-- Sound & Light -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="Night Sound &amp; Light Show (Kumbha Palace)"
                                android:textColor="@color/accent_gold"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:lineSpacingExtra="3dp"
                                android:text="@string/light_sound_info"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Bookings & Verified Cabs List Header -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="6dp"
                        android:text="Book Verified Guides &amp; Sanitized Cabs"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Services List -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerServices"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <!-- Official Portal Link Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="16dp"
                        app:cardBackgroundColor="@color/surface_white"
                        app:cardCornerRadius="16dp"
                        app:strokeColor="@color/border_subtle"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Official Tourism Portal"
                                android:textColor="@color/accent_gold"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/btnOpenWebsite"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="www.visitchittorgarh.in ↗"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Verified &amp; Published by ChittorTech"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>

        <!-- Bottom Navigation Bar (Elevated Clean White) -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_white"
            app:elevation="8dp"
            app:itemIconSize="22dp"
            app:itemIconTint="@drawable/bottom_nav_selector"
            app:itemTextColor="@drawable/bottom_nav_selector"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu" />

    </LinearLayout>

    <!-- 🧭 SIDE NAVIGATION DRAWER -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface_white"
        app:elevation="16dp"
        app:headerLayout="@layout/drawer_header"
        app:itemIconTint="@color/accent_gold"
        app:itemTextColor="@color/text_primary"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
