<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:gravity="top"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/txtStepNumber"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_badge_gold"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/gold_bright"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtStopTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stop Title (30 mins)"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtStopDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Brief stop description..."
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/txtStopTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="💡 Tip: ..."
            android:textColor="@color/gold_light"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>

